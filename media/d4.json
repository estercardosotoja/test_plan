{
  "swagger": "2.0",

  "info": {
    "title": "myBank",
    "description": "Sample Banking Service with allOf and discriminator",
    "version": "1.0.0"
  },
  "host": "api.mybank.com",
  "basePath": "/v1",
  "schemes": [
    "https"
  ],
  "definitions": {
    "Customer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "contacts": {
          "type":"array",
          "items": {
            "$ref": "#/definitions/Contact"
          }
        }
      },
      "required": [
        "id",
        "name"
      ]
    },

    "Contact": {
      "type": "object",
      "discriminator": "contactType",
      "properties": {
        "contactType": {
          "type": "string"
        },
        "primary": {
          "type": "boolean"
        },
        "timeOfDay": {
          "type": "string"
        }
      },
      "required": [
        "contactType",
        "primary"
      ]
    },
    "Phone": {
      "allOf": [
        {
          "$ref": "#/definitions/Contact"
        },
        {
          "type": "object",
          "properties": {
            "typeOfPhone": {
              "type":"string"
            },
            "phoneNumber":{
              "type":"string"
            }
          }
        }
      ]
    },
    "Email": {
      "allOf": [
        {
          "$ref": "#/definitions/Contact"
        },
        {
          "type": "object",
          "properties": {
            "email": {
              "type":"string"
            }
          }
        }
      ]
    }
  },

  "paths": {
    "/customers/{customerId}": {
      "get": {
        "summary": "Get the customer by ID.",
        "parameters": [{
          "in": "path",
          "name": "customerId",
          "required": true,
          "type": "integer"
        }],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Customer"
            }
          }
        }
      }
    }
  }
}
}